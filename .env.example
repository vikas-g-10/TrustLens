# GROQ_API_KEY: Required for claim reasoning (free key at https://console.groq.com/keys).
# Used server-side only; never exposed to the browser.
GROQ_API_KEY="your_groq_api_key"

# GROQ_MODEL: Groq model used for reasoning. Default: llama-3.3-70b-versatile
GROQ_MODEL="llama-3.3-70b-versatile"

# Phase 5 Multimodal AI Configuration
# Providers supported: "groq", "openai", "gemini", or custom OpenAI-compatible
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="qwen/qwen3.8-27b"
MULTIMODAL_MODEL="qwen/qwen3.8-27b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Configuration (Vercel / Vite client-side)
# VITE_API_BASE_URL: Base URL of your deployed FastAPI backend (e.g., https://trustlens-api.onrender.com)
# Leave empty in local development to use Vite's dev proxy (http://127.0.0.1:8000).
VITE_API_BASE_URL=""

# VITE_DEMO_VIDEOS_BASE_URL: Optional external storage URL for demo videos (e.g., Cloudflare R2 / AWS S3).
# If omitted or empty, videos are served locally from /demo-videos/.
VITE_DEMO_VIDEOS_BASE_URL=""

