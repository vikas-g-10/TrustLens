# --- TrustLens backend (set these in Vercel > Backend project > Settings > Environment Variables) ---
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Search
SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""

# Multimodal AI
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="qwen/qwen3.8-27b"
MULTIMODAL_MODEL="qwen/qwen3.8-27b"

# CORS: JSON list of allowed frontend origins (any *.vercel.app and localhost are already allowed by regex)
# CORS_ORIGINS='["https://your-frontend.vercel.app"]'
